<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon foreground: the glass document prism, centred inside the
  66/108 safe zone so no launcher mask clips it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Glass sheet body -->
    <path android:pathData="M38,30 L62,30 L74,42 L74,78 L38,78 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="38" android:startY="30"
                android:endX="74" android:endY="78">
                <item android:offset="0" android:color="#5FD8FF" />
                <item android:offset="0.45" android:color="#3B82F6" />
                <item android:offset="1" android:color="#7C4DFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Folded corner -->
    <path
        android:pathData="M62,30 L74,42 L62,42 Z"
        android:fillColor="#B8E6FF" />

    <!-- Layered sheet 1 -->
    <path android:pathData="M42,48 L66,42 L70,70 L46,76 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="42" android:startY="42"
                android:endX="70" android:endY="76">
                <item android:offset="0" android:color="#8FE3FF" />
                <item android:offset="1" android:color="#2E6BE6" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Layered sheet 2 -->
    <path android:pathData="M34,58 L56,52 L60,76 L38,82 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="34" android:startY="52"
                android:endX="60" android:endY="82">
                <item android:offset="0" android:color="#CFF3FF" />
                <item android:offset="1" android:color="#38BDF8" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Crescent highlight -->
    <path
        android:pathData="M46,26 m-9,0 a9,9 0 1,0 18,0 a9,9 0 1,0 -18,0 Z"
        android:fillColor="#FFF4C9" />
</vector>
