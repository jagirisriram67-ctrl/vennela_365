<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <external-path name="external_files" path="." />
    <cache-path name="cache_files" path="." />
    <files-path name="internal_files" path="." />
    <!--
        Removable SD cards and USB/OTG volumes live outside external-path.
        The provider stays exported="false"; only URIs explicitly granted on an
        outgoing intent are readable by the receiving app.
    -->
    <root-path name="all_volumes" path="/" />
</paths>
